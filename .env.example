# Copia questo file in .env e compila i valori prima del deploy
# Il file .env NON va mai committato su git

# Obbligatoria: stringa random di almeno 32 caratteri
# Genera con: openssl rand -hex 32
JWT_SECRET_KEY=CAMBIA_CON_UNA_STRINGA_RANDOM_LUNGA

# Backup v2: chiave casuale dedicata, >=32 caratteri, conservata fuori dal DB.
# Non ruotare/eliminare senza conservare la vecchia chiave nel keyring.
BACKUP_ENCRYPTION_KEY=
BACKUP_PREVIOUS_KEYS=[]
# JSON array delle vecchie JWT_SECRET_KEY per leggere backup .enc legacy.
LEGACY_BACKUP_JWT_SECRETS=[]
# Solo durante restore, dopo riavvio di UN SOLO backend e arresto altri writer.
BACKUP_MAINTENANCE_MODE=false

# Credenziali primo accesso admin
# Solo database vuoto: password casuale di almeno 12 caratteri, massimo 72 byte.
# Nessun fallback; custodire fuori da Git. Dopo il primo accesso cambiarla.
# Su database esistente questa variabile NON reimposta credenziali.
INITIAL_ADMIN_PASSWORD=

# Google AI (opzionale, solo se usi le funzioni AI)
GOOGLE_API_KEY=

# Licenze: l'URL deve puntare al server Autify-LICENSE pubblico in HTTPS.
# Il segreto condiviso deve coincidere con LICENSE_SHARED_SECRET configurato
# sul server licenze. Non copiare qui LICENSE_ADMIN_KEY: resta solo sul server.
LICENSE_SERVER_URL=https://licenze.ghome.it
LICENSE_SHARED_SECRET=CAMBIA_CON_UNA_STRINGA_RANDOM_DI_ALMENO_32_CARATTERI
LICENSE_SERVER_TIMEOUT_SECONDS=8
LICENSE_CACHE_HOURS=24
LICENSE_OFFLINE_GRACE_HOURS=72
LICENSE_REQUEST_FRESHNESS_SECONDS=120


# C7: sessioni nuove 15..480 minuti, default60. Le vecchie scadono al loro exp.
JWT_EXPIRY_MINUTES=60
CORS_ORIGINS=https://tiglio.autify.it,http://localhost:8090,http://localhost:8000
# Nuove cifrature IA richiedono chiave dedicata casuale >=32 caratteri.
AI_SETTINGS_ENCRYPTION_KEY=
AI_SETTINGS_PREVIOUS_KEYS=[]
# Vecchi JWT per leggere segreti IA enc:v1 dopo rotazione JWT.
AI_SETTINGS_LEGACY_JWT_KEYS=[]
# Allowlist ESATTA, niente sottodomini impliciti. Vuota: endpoint pubblici HTTPS.
ALLOWED_AI_HOSTS=
ALLOW_PRIVATE_AI_ENDPOINTS=false
# HTTP solo LAN esplicitamente autorizzata; mai loopback/link-local/metadata.
ALLOW_INSECURE_LOCAL_AI_HTTP=false

# Overlay Mongo autenticato: vedere SECURITY_OPERATIONS.md, NON attivare alla cieca.
# MONGODB_URL=mongodb://autify_app:PASSWORD_URL_ENCODED@autify-db:27017/autanalysis?authSource=autanalysis&replicaSet=autify-rs
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=
MONGO_APP_USERNAME=autify_app
MONGO_APP_PASSWORD=
MONGO_KEYFILE_PATH=./secrets/mongo-keyfile

# C8: solo per docker-compose.release.yml, dopo verifica artefatti/image-id.
AUTIFY_API_IMAGE=
AUTIFY_ADMIN_IMAGE=
